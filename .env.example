# Application
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/paypilot_ai

# AI provider configuration
# Use the Replit AI Integration in development; do not commit provider keys.
AI_MODEL=

# Razorpay test mode — keep the secret server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Authentication will use a managed provider; add its public configuration
# when the auth implementation phase begins.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=